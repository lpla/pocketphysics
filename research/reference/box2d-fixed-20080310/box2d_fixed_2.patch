+void ReversePolygon(b2Polygon& p){
+	ReversePolygon(p.x,p.y,p.nVertices);
+}
+	
+void ReversePolygon(float32* x, float32* y, int n) {
+        if (n == 1)
+            return;
+        int32 low = 0;
+        int32 high = n - 1;
+        while (low < high) {
+            float32 buffer = x[low];
+            x[low] = x[high];
+            x[high] = buffer;
+            buffer = y[low];
+            y[low] = y[high];
+            y[high] = buffer;
+            ++low;
+            --high;
+        }
+}
