+float32 b2Polygon::GetArea() {
+	if (areaIsSet) return area;
+	area = 0.0f;
+	
+	//First do wraparound
+	area += x[nVertices-1]*y[0]-x[0]*y[nVertices-1];
+	for (int i=0; i<nVertices-1; ++i){
+		area += x[i]*y[i+1]-x[i+1]*y[i];
+	}
+	area *= .5f;
+	areaIsSet = true;
+	return area;
+}
+
+bool b2Polygon::IsCCW() {
+	return (GetArea() > 0.0f);
+}
