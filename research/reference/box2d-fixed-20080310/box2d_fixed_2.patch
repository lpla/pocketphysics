+	./Collision/b2CollidePoly.cpp \
+	./Collision/b2CollideCircle.cpp \
+	./Collision/b2BroadPhase.cpp \
+	./Contrib/b2Polygon.cpp \
+	./Contrib/b2Triangle.cpp
+
+FLOAT_OBJECTS= $(addprefix Gen/float/,$(SOURCES:.cpp=.o))
