+//Fix for C++'s obnoxious behavior for the % operator for negative numbers...
+int32 remainder(int32 x, int32 modulus){
+	int32 rem = x % modulus;
+	while (rem < 0){
+		rem += modulus;
+	}
+	return rem;
+}
